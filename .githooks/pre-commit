#!/bin/sh
INPUT_FOLDER="${PRODUCTIVIDAD_INPUT_FOLDER:-C:/Users/felix.contreras/Desktop/Gestiones}"

powershell -NoProfile -ExecutionPolicy Bypass -File scripts/actualizar_vista_productividad.ps1 \
  -InputFolder "$INPUT_FOLDER" \
  -Catalog "asesores_catalogo.json" \
  -Output "productividad_view.json"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo "No se pudo generar productividad_view.json"
  exit $STATUS
fi

git add productividad_view.json
exit 0
